[layer_names]

2d_physics/layer_1="World"
2d_physics/layer_2="Umbrellas"
2d_physics/layer_3="Mint"
2d_physics/layer_4="Pedestrians"
2d_physics/layer_5="Crowd umbrellas (no rain cover)"

[physics]

3d/physics_engine="Jolt Physics"
2d/default_gravity=160.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.039, 0.075, 0.102, 1)
